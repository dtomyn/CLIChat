# Permit renewal API settings: UAT (synthetic)
ASPNETCORE_ENVIRONMENT=UAT
API_BASE_URL=https://permit-uat.contoso.example
DB_HOST=sql-permit-uat.contoso.internal
DB_NAME=permit_renewal
